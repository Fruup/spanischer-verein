{
	"name": "@spanischer-verein/web-v2",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev --port 5174",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview --port 5174",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run",
		"build-newsletter": "PUBLIC_RENDERING_NEWSLETTER=true bunx --bun vite build"
	},
	"devDependencies": {
		"@spanischer-verein/sanity": "../sanity",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.4",
		"@types/nodemailer": "^8.0.2",
		"@use-gesture/vanilla": "^10.3.1",
		"cookie": "^2.0.1",
		"drizzle-kit": "^1.0.0-rc.5",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-imagetools": "^12.0.1",
		"vitest": "^4.1.8",
		"zod": "^4.6.6"
	},
	"dependencies": {
		"@hostinger/sdk": "^2.5.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.62.0",
		"@portabletext/svelte": "^4.0.0",
		"@portabletext/types": "^4.0.2",
		"@sanity/client": "^8.9.0",
		"@sanity/image-url": "^2.1.1",
		"bits-ui": "^2.20.0",
		"cn": "^0.3.0",
		"drizzle-orm": "^1.0.0-rc.5",
		"flat-cache": "^6.1.23",
		"hostinger-mail-api-sdk": "^1.19.6",
		"jose": "^6.2.13",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^10.1.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"vaul-svelte": "^1.0.0-next.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#assets/*": "./src/assets/*"
	}
}
